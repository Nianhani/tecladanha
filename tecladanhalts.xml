  </row>
  <row>
    <key width="1.5" c="a" s="accent_tilde" se="accent_aigu" sw="accent_grave" n="ã" ne="á" nw="à" />
    <key c="s" ne="loc §" sw="loc ß"/> 
    <key c="d"/>
    <key c="f"/>
    <key c="g" se="." ne="&quot;" />
