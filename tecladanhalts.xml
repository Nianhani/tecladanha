    <key c="c" nw="ç" s="ç" />
    <key c="v" ne="&gt;" nw="&lt;" sw="(" se=")" />
    <key c="b" n="\?" sw="{" se="}" />
    <key c="n" nw=":" ne=";" sw="[" se="]"/>
    <key c="m" ne="&quot;" nw="?" sw="."  se="," />
